# Hub settings while OL-Integration is switched on.
# RBAC moves to OL-Integration ("legacy": its data_<tenant> schema is the authority). Read and write move
# together; detaching OL-Integration later is not supported.
BACKEND_SERVICE_URL=http://ol-integration:8080/backend
OL_RBAC_READ_SOURCE=legacy
OL_RBAC_WRITE_SOURCE=legacy
OL_RBAC_PARITY_ENABLED=true
OL_BACKEND_INTERNAL_URL=http://ol-integration
OL_BACKEND_INTERNAL_PORT=9095
# embedded gateway upstream (the app's container name and port in the Docker network)
OL_INTEGRATION_HOST=ol-integration
OL_INTEGRATION_PORT=8080
